    "ios": "npm run cap:sync && npm run cap:open"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "movie-engine": "file:plugins/movie-engine"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
