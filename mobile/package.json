{
  "name": "movie-stream-downloader-mobile",
  "version": "1.0.0",
  "description": "iOS port of Movie Stream Downloader",
  "private": true,
  "scripts": {
    "build:web": "node scripts/sync-web-assets.mjs",
    "cap:sync": "npm run build:web && npx cap sync ios",
